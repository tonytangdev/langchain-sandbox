{
  "name": "langchain-sandbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A one-shot tool-calling agent with a hand-written Agent Loop, built to be read.",
  "scripts": {
    "start": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "spike": "node --env-file-if-exists=.env --import tsx spike/one-shot-agent.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@langchain/core": "^1.2.5",
    "@langchain/openrouter": "^0.4.6",
    "@langchain/tavily": "^1.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3"
  }
}
