# Copy to `.env` (which is gitignored) and fill in.
# Loaded by Node's built-in --env-file; there is no dotenv dependency.

# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# https://app.tavily.com/home
# Not read at all when SEARXNG_URL is set.
TAVILY_API_KEY=

# Optional. Points web_search at your own SearXNG instead of Tavily — see the README for
# running one and for enabling its JSON output, without which it answers 403.
# SEARXNG_URL=http://localhost:8080
